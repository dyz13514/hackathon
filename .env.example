# 复制为 .env 后填值。.env 已在 .gitignore 中（R23.11）。
# app/settings.py 在启动时校验必需变量，缺失即拒绝启动。

# --- 必需 ---
# SQLAlchemy 连接串。SQLite 用相对路径即可；PostgreSQL 迁移时只改这一行（R27.4）
DATABASE_URL=sqlite:///./var/planning.db
# 演示环境的单一共享口令（Session_Auth，任务 1.5）
SESSION_SHARED_PASSWORD=change-me-before-demo
# 会话令牌签名密钥，≥32 字符
SESSION_SECRET_KEY=change-me-to-a-random-string-of-32-or-more-chars

# --- 可选 ---
APP_ENV=LOCAL
LOG_LEVEL=INFO
# LIVE | REPLAY | STUB | DISABLED。默认 REPLAY：构建期不消耗 Bedrock 额度（成本纪律）
LLM_MODE=REPLAY
# 逗号分隔。Vite 开发服务器默认端口 5173。
# 这一行还决定会话 Cookie 是否带 Secure 标记：全部来源为 https 时才带（任务 1.5）
CORS_ALLOW_ORIGINS=http://localhost:5173
UPLOAD_DIR=./var/uploads

# --- 仅 LLM_MODE=LIVE 时必需（缺失则拒绝以 LIVE 启动） ---
# 网关的**完整调用地址**（不拼接路径，原样 POST）。两种接口形态见下面的 LLM_API_STYLE：
#   Ollama 兼容： https://<网关主机>/api/chat
#   OpenAI 兼容（例如 DeepSeek）： https://api.deepseek.com/chat/completions
BEDROCK_GATEWAY_URL=
# 网关凭证，作为 `Authorization: Bearer <BEDROCK_API_KEY>` 发送。留空即不带该头。
BEDROCK_API_KEY=
# 可选：模型名，默认 sonnet4.5:latest（Ollama tag 形态）。只在 LIVE 模式下使用；
# 被显式置空同样拒绝启动。OpenAI 兼容服务请填对方的模型 id（DeepSeek：deepseek-chat）。
BEDROCK_MODEL=sonnet4.5:latest
# 请求体形态：OLLAMA（默认，向后兼容）| OPENAI（OpenAI 兼容服务，如 DeepSeek）。
# OPENAI 时 `temperature` / `max_tokens` 发在顶层且不发 Ollama 的 `options`；响应解析、
# 认证、重试/降级与 cassette 行为两种形态完全一致。
LLM_API_STYLE=OLLAMA
